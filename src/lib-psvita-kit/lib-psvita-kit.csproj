<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>lib-psvita-kit</AssemblyName>
    <PackageId>lib-psvita-kit</PackageId>
    <RootNamespace>LibPsVitaKit</RootNamespace>
    <Description>Convert and inspect PlayStation Vita files: read and write param.sfo, recognise .pkg, .vpk, NoNpDrm folders and Vita3K zips, read title and content IDs, decode zRIF licenses, and unpack Vita .pkg files (games, DLC, updates, PSM) into NoNpDrm folders. Pure managed; package keys built in, bring your own licenses.</Description>
    <PackageTags>psvita;ps-vita;vita;pkg;zrif;nonpdrm;vpk;sfo;param-sfo;vita3k;rom;convert</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="lib-psvita-kit.Tests" />
  </ItemGroup>
</Project>
